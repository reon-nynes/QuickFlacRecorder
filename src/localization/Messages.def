QFR_MESSAGE(InputUnavailable, "input_unavailable", "", "Format description when no stream is open.")
QFR_MESSAGE(DeviceUnavailableTip, "device_unavailable_tip", "name:text", "Tooltip for a remembered native input device that is missing.")
QFR_MESSAGE(FolderTip, "folder_tip", "path:text", "Full folder value followed by guidance. Preserve the path.")
QFR_MESSAGE(PrefixTip, "prefix_tip", "prefix:text", "Full editable prefix followed by guidance. Preserve counters and extensions.")
QFR_MESSAGE(DriverTip, "driver_tip", "name:text", "Full native audio driver name followed by guidance.")
QFR_MESSAGE(DeviceTip, "device_tip", "", "Guidance for selecting the microphone or interface used for metering and recording.")
QFR_MESSAGE(RecordTip, "record_tip", "", "Tooltip describing recording action and Space key behavior.")
QFR_MESSAGE(RefreshTip, "refresh_tip", "", "Tooltip describing connected-input rescan.")
QFR_MESSAGE(NextFilenameTitle, "next_filename_title", "", "Accessible name of filename preview.")
QFR_MESSAGE(NextFilename, "next_filename", "filename:text", "Complete filename preview caption. Filename remains verbatim.")
QFR_MESSAGE(Format, "format", "rate:text,channels:number", "Opened stream rate, fixed bit depth, codec, channel count. Rate is formatted data; channels is a plural number.")
QFR_MESSAGE(ElapsedTitle, "elapsed_title", "", "Accessible name of elapsed recording timer.")
QFR_MESSAGE(ElapsedDescription, "elapsed_description", "time:text", "Accessible description with numeric HH:MM:SS unchanged.")
QFR_MESSAGE(StatusTitle, "status_title", "", "Accessible name of recording status.")
QFR_MESSAGE(Ready, "ready", "", "Complete ready status.")
QFR_MESSAGE(Recording, "recording", "filename:text", "Complete active status with original .partial.flac filename.")
QFR_MESSAGE(Finalizing, "finalizing", "filename:text", "Complete status while finishing the original .partial.flac file.")
QFR_MESSAGE(Saved, "saved", "filename:text", "Complete successful status with original final .flac filename.")
QFR_MESSAGE(MeterTitle, "meter_title", "", "Accessible name of selected-channel peak level meter.")
QFR_MESSAGE(MeterDescription, "meter_description", "mode:text,left:text,right:text", "Accessible peaks in dBFS. mode is mono or stereo; left and right are formatted numeric data.")
QFR_MESSAGE(MeterMono, "meter_mono", "", "Short visible mono meter label.")
QFR_MESSAGE(MeterLeft, "meter_left", "", "Short visible left meter label.")
QFR_MESSAGE(MeterRight, "meter_right", "", "Short visible right meter label.")
QFR_MESSAGE(Clip, "clip", "", "Short visible clipping indicator held for 1.2 seconds.")

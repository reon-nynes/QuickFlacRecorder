QFR_MESSAGE(DriverUnavailable, "driver_unavailable", "driver:text,device:text,diagnostic:text,detail:text", "Input failure/recovery. driver/device are original native identities, even when unavailable. diagnostic: yes includes verbatim native detail; other omits it. Do not translate names or diagnose errors by their text.")
QFR_MESSAGE(DeviceUnavailable, "device_unavailable", "driver:text,device:text,diagnostic:text,detail:text", "Input failure/recovery. driver/device are original native identities, even when unavailable. diagnostic: yes includes verbatim native detail; other omits it. Do not translate names or diagnose errors by their text.")

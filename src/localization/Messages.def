// Stable IDs, JSON keys, named argument schemas, and translator context.
QFR_MESSAGE(TargetFolder, "target_folder", "", "Label for the only folder where recordings are saved.")
QFR_MESSAGE(Prefix, "prefix", "", "Label for the editable recording prefix, not the complete filename.")

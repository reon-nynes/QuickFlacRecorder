QFR_MESSAGE(IncompleteRecordings, "incomplete_recordings", "count:number,path:text", "Count of incomplete .partial.flac files in the actual target folder path. Count zero/one/multiple with the catalog cardinal rule. path is opaque data; these files have not finished saving.")
QFR_MESSAGE(RecordingFailure, "recording_failure", "reason:text,outcome:text,path:text,diagnostic:text,detail:text,inputDiagnostic:text,inputDetail:text", "Compound terminal result. reason: inputLost/discontinuity/overflow/diskFlush/promotion, other means writer. outcome: finalized/diskFlushFailed/promotionFailed, other means writerFailed. path is the actual retained full path; finalized audio still belongs to an interrupted take. diagnostic/inputDiagnostic: yes includes verbatim disk/native input detail; other omits it. Use complete sentences in each select variant.")
QFR_MESSAGE(NextRecordingUnavailable, "next_recording_unavailable", "outcome:text,guidance:text", "Preserve the completed take's translated outcome and append current validation guidance for the next recording.")
QFR_MESSAGE(DiskDiagnostic, "disk_diagnostic", "message:text,operation:text,code:number,detail:text", "Complete actionable recording/validation message with the first native disk diagnostic. operation: create/write/seek/flush/close/promotion/cleanup. code is the original GetLastError or errno value. detail is verbatim platform data.")

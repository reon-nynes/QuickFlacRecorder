QFR_MESSAGE(DeviceOpenFailed, "device_open_failed", "driver:text,device:text,platform:text,detail:text", "Input-open failure. platform: windows/mac/other selects OS-specific permission and recovery guidance. driver/device are original native identities; detail is the verbatim native open error. Keep OS setting names recognizable.")

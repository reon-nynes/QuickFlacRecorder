QFR_MESSAGE(OutputOpenFailed, "output_open_failed", "retained:text,path:text,diagnostic:text,detail:text", "Recording-start failure. retained: yes includes path to the actual incomplete recording; other omits it. diagnostic: yes includes verbatim native detail; other omits it. path/detail are opaque user/platform data.")
QFR_MESSAGE(WriterStartFailed, "writer_start_failed", "retained:text,path:text,diagnostic:text,detail:text", "Recording-start failure. retained: yes includes path to the actual incomplete recording; other omits it. diagnostic: yes includes verbatim native detail; other omits it. path/detail are opaque user/platform data.")

QFR_MESSAGE(DeviceStartFailed, "device_start_failed", "driver:text,device:text,diagnostic:text,detail:text", "Input failure/recovery. driver/device are original native identities, even when unavailable. diagnostic: yes includes verbatim native detail; other omits it. Do not translate names or diagnose errors by their text.")

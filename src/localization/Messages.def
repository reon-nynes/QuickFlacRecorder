QFR_MESSAGE(RightInput, "right_input", "", "Label for the stereo right input channel.")
QFR_MESSAGE(Mono, "mono", "", "One-channel recording mode.")
QFR_MESSAGE(Stereo, "stereo", "", "Two-channel recording mode.")
QFR_MESSAGE(Browse, "browse", "", "Button that opens the native target-folder chooser.")
QFR_MESSAGE(Refresh, "refresh", "", "Button that rescans connected input devices.")
QFR_MESSAGE(Record, "record", "", "Idle recording action, with a dot icon.")
QFR_MESSAGE(Stop, "stop", "", "Active recording action, with a square icon.")
QFR_MESSAGE(Finishing, "finishing", "", "Disabled recording action while the FLAC finishes saving.")
QFR_MESSAGE(Choose, "choose", "", "Placeholder for selectors with no selected item.")
QFR_MESSAGE(NoChoices, "no_choices", "", "Empty selector popup placeholder.")
QFR_MESSAGE(Unavailable, "unavailable", "name:text", "Annotation around an original native driver or device name. Never an identity.")
